# WHY: package-lock.json is written by npm 11, and npm 10 disagrees with npm 11
# about optional peer dependencies (@puppeteer/browsers 3.x), so an npm 10
# `npm install` silently rewrites the lockfile into a shape npm 11's `npm ci`
# rejects (this broke CI on 2026-08-14). engine-strict turns the engines.npm
# constraint in package.json into a hard install-time error instead of a warning.
# Removing this file reopens the silent-lockfile-corruption path for anyone on
# bundled npm 10. Every npm ci environment (CI workflows, Vercel installCommand)
# bootstraps npm 11 first, so they all pass this gate.
engine-strict=true
