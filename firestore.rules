rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function syntheticEmail(email) {
      return email is string && email.lower().matches('synthetic-monitor([+][0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})?@garammasaladating[.]com');
    }
    function validSyntheticMarker(d) {
      return ('email' in d.keys() && syntheticEmail(d.email))
        ? ('isSynthetic' in d.keys() && d.isSynthetic == true)
        : (!('isSynthetic' in d.keys()) || d.isSynthetic == false);
    }
    // Only the monitor service account can manage cleanup evidence.
    match /syntheticRuns/{id} { allow read, write: if false; }

    // WHY the odd-looking 200/400/4000 text caps here: the owner's rule is that no real person may ever
    // hit a length limit, so free-text ceilings are anti-bot-flood bounds
    // only, set far beyond human writing. Each cap is 4x the client-side
    // check in src/lib/applicationFieldLimits.ts because rules size() and
    // JS .length count multi-byte text differently (up to 4 bytes per
    // UTF-16 pair); 4x guarantees any string the client accepts passes
    // here under any counting scheme. Lowering these re-creates the Aug
    // 2026 "Missing or insufficient permissions" rejections of real
    // applicants (long pitch, spelled-out height, formatted phone).
    function validLead() {
      let d = request.resource.data;
      // Match JavaScript trim(), including Unicode spaces that RE2 \s omits.
      let trimWhitespace = '[\\x09-\\x0D\\x20\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*';
      return d.keys().hasOnly(['email', 'city', 'state', 'country', 'phone', 'name', 'instagram', 'source', 'sourcePage', 'landingPage', 'referrerHost', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'fbclid', 'gclid', 'posthogDistinctId', 'sourceCitySlug', 'createdAt', 'geoCity', 'geoRegion', 'geoCountry', 'geoLatitude', 'geoLongitude', 'geoTimezone', 'isSynthetic'])
        && validSyntheticMarker(d)
        && d.keys().hasAll(['email', 'source', 'sourcePage', 'createdAt'])
        && d.email is string && d.email.size() > 0 && d.email.size() <= 1280
        // Browser smoke success is mocked; real test writes belong in the emulator.
        && !d.email.lower().matches(trimWhitespace + 'smoketest@example[.]com' + trimWhitespace)
        && d.source is string && d.source.size() > 0 && d.source.size() <= 50
        && d.sourcePage is string && d.sourcePage.size() > 0 && d.sourcePage.size() <= 200
        && d.createdAt is string && d.createdAt.size() > 0 && d.createdAt.size() <= 30
        && (!('phone' in d.keys()) || (d.phone is string && d.phone.size() > 0 && d.phone.size() <= 200))
        && (!('name' in d.keys()) || (d.name is string && d.name.size() > 0 && d.name.size() <= 4000))
        && (!('instagram' in d.keys()) || (d.instagram is string && d.instagram.size() > 0 && d.instagram.size() <= 400))
        && (!('city' in d.keys()) || (d.city is string && d.city.size() > 0 && d.city.size() <= 4000))
        && (!('state' in d.keys()) || (d.state is string && d.state.size() > 0 && d.state.size() <= 100))
        && (!('country' in d.keys()) || (d.country is string && d.country.size() > 0 && d.country.size() <= 100))
        && (!('landingPage' in d.keys()) || (d.landingPage is string && d.landingPage.size() > 0 && d.landingPage.size() <= 200))
        && (!('referrerHost' in d.keys()) || (d.referrerHost is string && d.referrerHost.size() > 0 && d.referrerHost.size() <= 255))
        && (!('utmSource' in d.keys()) || (d.utmSource is string && d.utmSource.size() > 0 && d.utmSource.size() <= 100))
        && (!('utmMedium' in d.keys()) || (d.utmMedium is string && d.utmMedium.size() > 0 && d.utmMedium.size() <= 100))
        && (!('utmCampaign' in d.keys()) || (d.utmCampaign is string && d.utmCampaign.size() > 0 && d.utmCampaign.size() <= 150))
        && (!('utmContent' in d.keys()) || (d.utmContent is string && d.utmContent.size() > 0 && d.utmContent.size() <= 150))
        && (!('utmTerm' in d.keys()) || (d.utmTerm is string && d.utmTerm.size() > 0 && d.utmTerm.size() <= 150))
        && (!('fbclid' in d.keys()) || (d.fbclid is string && d.fbclid.size() > 0 && d.fbclid.size() <= 500))
        && (!('gclid' in d.keys()) || (d.gclid is string && d.gclid.size() > 0 && d.gclid.size() <= 500))
        && (!('posthogDistinctId' in d.keys()) || (d.posthogDistinctId is string && d.posthogDistinctId.size() > 0 && d.posthogDistinctId.size() <= 200))
        && (!('sourceCitySlug' in d.keys()) || (d.sourceCitySlug is string && d.sourceCitySlug.size() > 0 && d.sourceCitySlug.size() <= 100))
        && (!('geoCity' in d.keys()) || (d.geoCity is string && d.geoCity.size() > 0 && d.geoCity.size() <= 100))
        && (!('geoRegion' in d.keys()) || (d.geoRegion is string && d.geoRegion.size() > 0 && d.geoRegion.size() <= 100))
        && (!('geoCountry' in d.keys()) || (d.geoCountry is string && d.geoCountry.size() > 0 && d.geoCountry.size() <= 100))
        && (!('geoLatitude' in d.keys()) || (d.geoLatitude is number && d.geoLatitude >= -90 && d.geoLatitude <= 90))
        && (!('geoLongitude' in d.keys()) || (d.geoLongitude is number && d.geoLongitude >= -180 && d.geoLongitude <= 180))
        && (!('geoTimezone' in d.keys()) || (d.geoTimezone is string && d.geoTimezone.size() > 0 && d.geoTimezone.size() <= 100));
    }

    // Intentional: the step-2 contact capture flow runs from the browser without
    // auth. A caller needs the Firestore document ID (returned by
    // /api/capture-lead) to reach this path, so the exposure is bounded. The
    // rule restricts the update to progressive-capture contact fields plus
    // source (so a completed application can mark its partial lead as
    // superseded) and enforces type and length constraints.
    // Additionally, once LEAD_UPDATE_SECRET is configured, /api/update-lead
    // requires an HMAC-signed 10 minute token issued by /api/capture-lead
    // (src/lib/leadToken.ts) and derives the doc id from that token. This rule
    // stays as the defense for writes that bypass the API and hit Firestore
    // REST directly; rules cannot verify HMACs.
    function validLeadContactUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['phone', 'instagram', 'name', 'source'])
        && changed.size() > 0
        && (!changed.hasAny(['phone']) || (d.phone is string && d.phone.size() > 0 && d.phone.size() <= 200))
        && (!changed.hasAny(['instagram']) || (d.instagram is string && d.instagram.size() > 0 && d.instagram.size() <= 400))
        && (!changed.hasAny(['name']) || (d.name is string && d.name.size() > 0 && d.name.size() <= 4000))
        && (!changed.hasAny(['source']) || (d.source is string && d.source.size() > 0 && d.source.size() <= 50));
    }

    // Admin gate for all PII reads and management. Admin operations require a
    // non-anonymous account that is on the email allowlist or carries an
    // `admin` custom claim. If the admin login email ever changes, update the
    // allowlist below.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.email in ['messagesurbhi@gmail.com', 'contact@garammasaladating.com']
            || ('admin' in request.auth.token && request.auth.token.admin == true));
    }

    // WHY applications has NO public create and no validation function: the
    // apply form posts to /api/save-application, which writes with the
    // service account (rules do not apply to it) and accepts any content
    // (owner rule: never reject a real applicant). Field validation in
    // client-facing rules caused every "Missing or insufficient permissions"
    // outage (Jul, Aug, Sep, Nov 2026). Re-adding a client create path, or a
    // validApplication() style whitelist, re-creates that outage class. The
    // canary in tests/canary exercises the real endpoint every 30 minutes.
    match /applications/{doc} {
      allow read, create, update, delete: if isAdmin();
    }
    match /applications/{doc}/{subcollection=**} {
      // Subcollections (status events) are written only by the admin dashboard.
      allow read, create, update, delete: if isAdmin();
    }
    match /leads/{doc} {
      // Public email capture stays open; follow-up updates are bounded to
      // the progressive-capture contact fields. Reads/deletes are admin-only
      // so the waitlist can never be enumerated by an anonymous session.
      allow create: if validLead();
      allow update: if validLeadContactUpdate() || isAdmin();
      allow read, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false; // server-only via REST API with service account
    }
    match /syncMeta/{docId} {
      allow read: if isAdmin();
      allow write: if false; // server-only via REST API with service account
    }
    match /systemConfig/{docId} {
      allow read, write: if isAdmin();
    }
    // Failure-alert log written by the server (src/lib/opsAlert.ts) and read by
    // the daily digest; admins may read it, nobody writes from a client.
    match /incidents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Production canary documents (service account only, never client).
    match /_canary/{docId} {
      allow read, write: if false;
    }
  }
}
