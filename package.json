{
  "name": "garam-masala-dating",
  "description": "Website, contestant application system, and admin dashboard for Garam Masala Dating — a live comedy dating show.",
  "private": true,
  "version": "1.0.0",
  "license": "SEE LICENSE",
  "author": "Garam Masala Dating",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellosurbhi/garam-masala-dating.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/ping-indexnow.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "check": "astro check",
    "migrate:locations": "npx tsx scripts/migrate-locations.ts",
    "admin:grant-claims": "node --env-file=.env.local scripts/grant-admin-claims.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-garam-masala \"vitest run --config vitest.rules.config.ts\"",
    "prepare": "chmod +x .husky/pre-commit .husky/commit-msg .husky/pre-push",
    "images:organize": "node scripts/organize-images.js",
    "images:organize:v": "VERBOSE=1 node scripts/organize-images.js",
    "images:optimize": "node scripts/optimize-images.js",
    "images:optimize:v": "VERBOSE=1 node scripts/optimize-images.js",
    "test:links": "linkinator https://garammasaladating.com --recurse --timeout 30000 --retry --skip 'eventbrite.com|instagram.com|tiktok.com|facebook.com|twitter.com|x.com|youtube.com|linkedin.com'",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:preview": "PLAYWRIGHT_BASE_URL=$VERCEL_PREVIEW_URL playwright test",
    "perf:lighthouse": "node scripts/run-lhci.mjs lighthouserc.cjs",
    "perf:mobile": "node scripts/run-lhci.mjs lighthouserc.mobile.cjs",
    "test:mutate": "stryker run",
    "test:mutate:incremental": "stryker run --incremental",
    "mutation:ratchet": "bash scripts/mutation-ratchet.sh"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.2",
    "country-state-city": "^3.2.1",
    "firebase": "^12.17.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-loading-skeleton": "^3.5.0",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.27.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "linkinator": "^7.6.1",
    "lint-staged": "^17.3.0",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.0",
    "qs": "^6.15.2",
    "tmp": "^0.2.6",
    "uuid": ">=11.1.1",
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{ts,tsx,js,jsx,astro}": [
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
