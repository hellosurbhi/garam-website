---
import type { EventEntry } from "@/data/events";
import { buildTicketUrl } from "@/utils/eventUrl";
import { formatEventLocation } from "@/utils/eventCity";
import { formatDisplayTime } from "@/utils/eventDate";
import { domainFromUrl, vendorFromUrl } from "@/lib/analyticsCapture";
import { EVENTS } from "@/data/copy";

interface Props {
  event: EventEntry;
  citySlug: string;
}

const { event, citySlug } = Astro.props;

const isSoldOut = event.soldOut ?? false;
const eventLocation = formatEventLocation(event);
// Sold-out clicks go straight to the Eventbrite/vendor listing (there's no
// checkout to track), so this is the only place the tagged direct URL is
// still needed. Live events route through the tracked redirect below.
const soldOutUrl = buildTicketUrl(event.url, "cities", citySlug);
const goHref = `/api/go/${event.slug}`;
const eventTitle = `Garam Masala Dating - ${eventLocation} - ${event.date}`;
const ctaText = isSoldOut ? "Sold Out" : `${event.date}: ${EVENTS.ticketCta}`;

/*
 * Card display data.
 * Strip bureaucratic "Township" suffix so "North Brunswick Township" reads
 * as "North Brunswick" to the user.
 */
const venueTown = (event.venue?.addressLocality ?? "").replace(
  /\s+Township$/,
  "",
);
const venueDisplay = event.venue?.name
  ? venueTown
    ? `${event.venue.name}, ${venueTown}`
    : event.venue.name
  : eventLocation;
const timeDisplay = event.startTime ? formatDisplayTime(event.startTime) : null;

const sharedAttrs = {
  "data-ph-capture": "ticket_click",
  "data-ph-cta": "city_card",
  "data-ph-section": "cities",
  "data-ph-event-date": event.isoDate ?? event.date,
  "data-ph-event-title": eventTitle,
  "data-cta-position": "city_card",
  "data-cta-text": ctaText,
  "data-event-city": eventLocation,
  "data-event-date": event.isoDate ?? event.date,
  "data-event-title": eventTitle,
  "data-city-slug": citySlug,
};

const arrowPath1 = "M5 12h14";
const arrowPath2 = "m12 5 7 7-7 7";
---

{
  isSoldOut ? (
    <a
      href={soldOutUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="city-cta city-cta--primary city-cta--soldout"
      data-link-domain={domainFromUrl(soldOutUrl)}
      data-event-vendor={vendorFromUrl(soldOutUrl)}
      {...sharedAttrs}
    >
      <span>{ctaText}</span>
    </a>
  ) : (
    /*
     * One clean card for every live event, ours or third-party: venue,
     * date, doors, "Get Tickets" routed through the tracked redirect
     * (src/pages/api/go/[slug].ts), no iframe, no modal, no visible price
     * (pricing is never shown in the UI, see CLAUDE.md). This branch used
     * to be reserved for non-Eventbrite vendors only, while Eventbrite-owned
     * shows rendered a raw inline iframe embed above it; that embed (and
     * EventbriteWidgetInit.astro, which mounted it) is retired in favor of
     * this single consistent treatment for both.
     */
    <div class="vendor-card">
      <p class="vendor-card__eyebrow">{EVENTS.showName}</p>
      <p class="vendor-card__date">
        {event.date}
        {timeDisplay && (
          <>
            {" "}
            · {EVENTS.doorsLabel} {timeDisplay}
          </>
        )}
      </p>
      <p class="vendor-card__venue">{venueDisplay}</p>
      <a
        href={goHref}
        target="_blank"
        rel="noopener noreferrer"
        class="city-cta city-cta--primary vendor-card__cta"
        data-go-ticket
        data-event-slug={event.slug}
        data-event-vendor={event.ticketSource}
        {...sharedAttrs}
      >
        <span>{EVENTS.getTicketsCta}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="city-cta__arrow"
          aria-hidden="true"
        >
          <path d={arrowPath1} />
          <path d={arrowPath2} />
        </svg>
      </a>
    </div>
  )
}

<script>
  import { wireTicketCtaTracking } from "@/lib/ticketCtaTracking";
  wireTicketCtaTracking();
</script>

<style>
  /*
   * Clean card: always visible (never gated behind widget load/failure,
   * there is no widget anymore).
   */
  .vendor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 28px 24px;
    background: var(--white);
    border: 1px solid rgba(var(--brand-red-rgb), 0.18);
    border-radius: 12px;
    text-align: center;
    scroll-margin-top: 80px;
  }

  .vendor-card__eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brand-red);
    margin: 0;
  }

  .vendor-card__date {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--charcoal);
    margin: 0;
  }

  .vendor-card__venue {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .vendor-card__cta {
    width: 100%;
    white-space: nowrap;
  }

  .city-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-radius: 14px;
    border: 1px solid;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    appearance: none;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      transform 0.15s;
    width: 100%;
    text-align: left;
  }

  .city-cta:active {
    transform: scale(0.97);
  }

  .city-cta--primary {
    border-color: rgba(var(--brand-red-rgb), 0.5);
    background: rgba(var(--brand-red-rgb), 0.1);
    color: var(--brand-red);
  }

  .city-cta--primary:hover {
    border-color: rgba(var(--brand-red-rgb), 0.7);
    background: rgba(var(--brand-red-rgb), 0.15);
  }

  .city-cta--soldout {
    border-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.04);
    color: var(--muted);
    cursor: default;
  }

  .city-cta__arrow {
    flex-shrink: 0;
  }
</style>
