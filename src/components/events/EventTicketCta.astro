---
/**
 * The one "get me to checkout" CTA for a /events/[slug] page. Renders exactly
 * one of six states depending on the event's actual data, never a dead
 * button. Every live/presale anchor below carries `data-go-ticket`; the
 * click/tracking behavior itself lives in the shared
 * src/lib/ticketCtaTracking.ts module (wireTicketCtaTracking()), which every
 * other ticket CTA on the site (TicketCard, HomeShows, HomeHero,
 * CityEventTicketEmbed) also calls, so there is one click handler instead of
 * five near-duplicates.
 */
import type { EventEntry } from "@/data/events";
import { formatEventLocation } from "@/utils/eventCity";
import { formatOnSaleDate, isEventDatePast } from "@/utils/eventDate";
import { vendorFromUrl } from "@/lib/analyticsCapture";

interface Props {
  event: EventEntry;
  /** data-cta-position value for analytics, e.g. "event_hero" or "event_bottom". */
  position: string;
}

const { event, position } = Astro.props;

const cityLabel = formatEventLocation(event);
const eventTitle = `Garam Masala Dating - ${cityLabel} - ${event.date}`;
// WHY: this page is permanent/statically generated, so a future rebuild
// must not reclassify an old show as upcoming (see isEventDatePast's doc
// comment for why event.date alone can't be trusted for that).
const isPast = isEventDatePast(event);
// WHY canceled outranks every other state, including isPast: a canceled
// show keeps its permanent landing page (never-delete events rule) and its
// url field still points at the dead Eventbrite listing, so any branch that
// renders a checkout anchor would send visitors to a listing that cannot
// sell them anything. /api/go/[slug].ts applies the same guard server-side
// for old shared links that bypass this page.
const isCanceled = event.status === "canceled";
const isSoldOut = event.soldOut ?? false;
const isLive = Boolean(event.url) && event.url !== "#";
const isPresale =
  Boolean(event.onSaleAt) && new Date(event.onSaleAt!) > new Date();
const onSaleLabel = event.onSaleAt ? formatOnSaleDate(event.onSaleAt) : "";

// WHY the two "Get Tickets" anchors below carry no target="_blank" (every
// other ticket CTA on the site does: TicketCard, HomeShows, HomeHero,
// CityEventTicketEmbed): this page is what paid Instagram/TikTok/Facebook
// ads land visitors on, and those apps' in-app browsers are WebViews with
// unreliable target="_blank"/window.open() support, sometimes silently
// doing nothing, sometimes opening a tab a non-technical visitor can't find
// their way back from. A same-tab navigation that takes a moment is
// recoverable; a silently-blocked new tab strands the visitor with no
// checkout link at all. See src/lib/ticketCtaTracking.ts for the loading
// state that keeps that moment from reading as a dead button.
const goHref = `/api/go/${event.slug}`;

const sharedTrackingAttrs = {
  "data-ph-section": position,
  "data-ph-city": cityLabel,
  "data-ph-event-date": event.isoDate ?? event.date,
  "data-ph-event-title": eventTitle,
  "data-cta-position": position,
  "data-event-city": cityLabel,
  "data-event-date": event.isoDate ?? event.date,
  "data-event-title": eventTitle,
};
---

{
  isCanceled && (
    <div class="event-cta event-cta--past">
      <p class="event-cta__note">This show was canceled.</p>
      <a href="/tickets" class="event-cta__button event-cta__button--outline">
        See Upcoming Shows
      </a>
    </div>
  )
}

{
  !isCanceled && isPast && (
    <div class="event-cta event-cta--past">
      <p class="event-cta__note">This show has already happened.</p>
      <a href="/tickets" class="event-cta__button event-cta__button--outline">
        See Upcoming Shows
      </a>
    </div>
  )
}

{
  !isCanceled && !isPast && isSoldOut && (
    <button
      type="button"
      class="event-cta__button event-cta__button--notify"
      data-notify-city={cityLabel}
      data-notify-city-slug={event.citySlug}
      data-ph-capture="cta_clicked"
      data-ph-cta="notify_me"
      data-cta-text="Sold Out, Get Notified"
      {...sharedTrackingAttrs}
    >
      Sold Out. Get Notified for the Next Show
    </button>
  )
}

{
  !isCanceled && !isPast && !isSoldOut && isPresale && (
    <>
      <button
        type="button"
        class="event-cta__button event-cta__button--notify"
        data-notify-city={cityLabel}
        data-notify-city-slug={event.citySlug}
        data-notify-on-sale-at={event.onSaleAt}
        data-presale-notify={event.onSaleAt}
        data-ph-capture="cta_clicked"
        data-ph-cta="notify_me"
        data-cta-text="Notify Me"
        {...sharedTrackingAttrs}
      >
        Notify Me. On Sale {onSaleLabel}
      </button>
      <a
        href={goHref}
        class="event-cta__button event-cta__button--primary"
        data-go-ticket
        data-presale-live
        hidden
        data-event-slug={event.slug}
        data-event-vendor={vendorFromUrl(event.url)}
        data-ph-capture="cta_clicked"
        data-ph-cta="get_tickets"
        data-cta-text="Get Tickets"
        {...sharedTrackingAttrs}
      >
        Get Tickets
      </a>
    </>
  )
}

{
  !isCanceled && !isPast && !isSoldOut && !isPresale && !isLive && (
    <button
      type="button"
      class="event-cta__button event-cta__button--notify"
      data-notify-city={cityLabel}
      data-notify-city-slug={event.citySlug}
      data-ph-capture="cta_clicked"
      data-ph-cta="notify_me"
      data-cta-text="Notify Me"
      {...sharedTrackingAttrs}
    >
      Notify Me When Tickets Drop
    </button>
  )
}

{
  !isCanceled && !isPast && !isSoldOut && !isPresale && isLive && (
    <a
      href={goHref}
      class="event-cta__button event-cta__button--primary"
      data-go-ticket
      data-event-slug={event.slug}
      data-event-vendor={vendorFromUrl(event.url)}
      data-ph-capture="cta_clicked"
      data-ph-cta="get_tickets"
      data-cta-text="Get Tickets"
      {...sharedTrackingAttrs}
    >
      Get Tickets
    </a>
  )
}

<script>
  import { wireTicketCtaTracking } from "@/lib/ticketCtaTracking";
  wireTicketCtaTracking();
</script>

<style>
  .event-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .event-cta__note {
    font-size: 15px;
    color: var(--text-secondary, var(--muted));
  }

  .event-cta__button {
    display: block;
    width: 100%;
    max-width: 360px;
    padding: 18px 36px;
    border-radius: 50px;
    font-family: var(--font-body), sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-align: center;
    min-height: var(--touch-target);
    border: none;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.06s;
  }

  .event-cta__button:active {
    transform: scale(0.97);
  }

  .event-cta__button--primary {
    background: var(--brand-red);
    color: white;
  }

  .event-cta__button--primary:hover {
    background: var(--brand-red-dark);
  }

  .event-cta__button--notify {
    background: rgba(var(--brand-red-rgb), 0.08);
    color: var(--brand-red);
    border: 1.5px solid rgba(var(--brand-red-rgb), 0.35);
  }

  .event-cta__button--notify:hover {
    background: rgba(var(--brand-red-rgb), 0.15);
  }

  .event-cta__button--outline {
    background: transparent;
    color: var(--charcoal);
    border: 1.5px solid rgba(0, 0, 0, 0.15);
  }

  .event-cta__button--outline:hover {
    border-color: var(--charcoal);
  }

  /* WHY :global here: wireTicketCtaTracking() (src/lib/ticketCtaTracking.ts)
     injects the spinner element and toggles aria-busy at click time, after
     Astro has already applied its scoped-style hash to the template. A
     plain scoped selector would silently never match a node that didn't
     exist at render time. */
  :global(.event-cta__button[aria-busy="true"]) {
    opacity: 0.85;
    cursor: default;
    pointer-events: none;
  }

  :global(.event-cta__spinner) {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-left: 10px;
    vertical-align: -3px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: event-cta-spin 0.6s linear infinite;
  }

  /* No per-component prefers-reduced-motion override needed: the global
     kill-switch in src/index.css already zeroes every animation's duration
     and iteration count site-wide. */
  @keyframes event-cta-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
