---
import type { EventEntry } from "@/data/events";
import NotifyModal from "@/components/NotifyModal.astro";
import HomeShowCards from "./HomeShowCards.astro";
import WaitlistCities from "@/components/tickets/WaitlistCities.astro";
import { PAGES } from "@/data/copy";
interface Props {
  events: EventEntry[];
  candidates: EventEntry[];
  todayISO: string;
  nowISO: string;
}
const { events, candidates, todayISO, nowISO } = Astro.props;
---

<section class="shows" id="shows" aria-labelledby="shows-heading">
  <div class="shows-header" data-reveal>
    <h2 id="shows-heading">Grab Your Seat</h2>
    <p>Tickets always sell out. You've been warned.</p>
    <p class="shows-proof">
      40+ shows sold out · 2,000+ audience members · 13 couples matched
    </p>
  </div>
  <div class="shows-list" data-reveal-stagger>
    <HomeShowCards events={events} />
    <WaitlistCities
      server:defer
      upcoming={candidates}
      todayISO={todayISO}
      nowISO={nowISO}
      scheduledCount={events.length}
      sourcePage="home"
    >
      <p slot="fallback">{PAGES.tickets.waitlistLoading}</p>
    </WaitlistCities>
  </div>
  <div class="request-city" data-reveal>
    <button
      type="button"
      id="request-city-trigger"
      data-ph-capture="cta_clicked"
      data-ph-cta="request_city"
      data-ph-section="shows"
    >
      Don't see your city? Request it →
    </button>
  </div>

  <NotifyModal />

  <!-- Request City Modal -->
  <dialog id="request-city-modal" class="modal-dialog">
    <div class="modal-inner">
      <button type="button" class="modal-close" aria-label="Close">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
      <div id="city-form-view">
        <h2 class="modal-title">Request Your City</h2>
        <p class="modal-subtitle">
          Tell us where you want Garam Masala Dating and we'll make it happen.
        </p>
        <form
          id="city-form"
          class="modal-form"
          toolname="request-show-in-my-city"
          tooldescription="Request Garam Masala Dating to bring a live show to your city. Provide city name and email address to join the city interest list."
        >
          <input
            type="text"
            id="city-name"
            placeholder="Your city"
            aria-label="City name"
            autocomplete="off"
            required
            toolparamdescription="Name of the city where you want Garam Masala Dating to perform"
          />
          <input
            type="email"
            id="city-email"
            class="ph-mask"
            placeholder="Your email"
            required
            aria-label="Email address"
            toolparamdescription="Email address to be notified when the show comes to your city"
          />
          <p id="city-form-error" class="modal-error" hidden role="alert"></p>
          <button type="submit" class="modal-submit">
            Submit Request
          </button>
        </form>
      </div>
      <div id="city-success" class="modal-success" hidden>
        <p>Request received! We'll keep you posted.</p>
      </div>
    </div>
  </dialog>
</section>

<script>
  import "@/lib/presaleReveal";
</script>

<script>
  import { wireTicketCtaTracking } from "@/lib/ticketCtaTracking";
  wireTicketCtaTracking();
</script>

<script>
  import { identifyLead, trackLeadEvent } from "@/lib/analytics";
  import { buildLeadAttribution } from "@/lib/leadAttribution";
  import {
    captureLead,
    type LeadSubmissionPayload,
  } from "@/lib/leadSubmission";

  // Request City modal
  const cityDialog = document.getElementById(
    "request-city-modal",
  ) as HTMLDialogElement;
  if (cityDialog) {
    const cityInput = document.getElementById(
      "city-name",
    ) as HTMLInputElement | null;
    const errorEl = document.getElementById("city-form-error");

    document
      .getElementById("request-city-trigger")
      ?.addEventListener("click", () => {
        // Reset to form state before opening
        document.getElementById("city-form-view")?.removeAttribute("hidden");
        document.getElementById("city-success")?.setAttribute("hidden", "");
        const emailInput = document.getElementById(
          "city-email",
        ) as HTMLInputElement;
        if (cityInput) cityInput.value = "";
        if (emailInput) emailInput.value = "";
        if (errorEl) {
          errorEl.textContent = "";
          errorEl.setAttribute("hidden", "");
        }
        trackLeadEvent("request_city_opened", {
          source: "request-city",
          sourcePage: window.location.pathname,
        });
        cityDialog.showModal();
      });

    let isClosing = false;
    const closeCityDialog = () => {
      if (isClosing) return;
      const inner = cityDialog.querySelector(
        ".modal-inner",
      ) as HTMLElement | null;
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!inner || reduced) {
        cityDialog.close();
        return;
      }
      isClosing = true;
      cityDialog.classList.add("closing");
      inner.addEventListener(
        "animationend",
        () => {
          cityDialog.classList.remove("closing");
          isClosing = false;
          cityDialog.close();
        },
        { once: true },
      );
    };

    cityDialog
      .querySelector(".modal-close")
      ?.addEventListener("click", closeCityDialog);
    cityDialog.addEventListener("click", (e) => {
      if (e.target === cityDialog) closeCityDialog();
    });
    cityDialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeCityDialog();
    });

    document
      .getElementById("city-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = (
          e.target as HTMLFormElement
        ).querySelector<HTMLButtonElement>('[type="submit"]');
        const originalBtnText = submitBtn?.textContent ?? "";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Submitting...";
        }
        try {
          const city = (cityInput?.value ?? "").trim();
          const email = (
            document.getElementById("city-email") as HTMLInputElement
          ).value;
          const attribution = await buildLeadAttribution({
            source: "request-city",
          });
          const payload: LeadSubmissionPayload = {
            email,
            ...attribution,
          };
          if (city) payload.city = city;
          await captureLead(payload);
          const cityProp = city ? { city } : {};
          identifyLead(email, { ...attribution, ...cityProp });
          trackLeadEvent("lead_email_submitted", {
            ...attribution,
            ...cityProp,
          });
          trackLeadEvent("email_signup", { ...attribution, ...cityProp });
          trackLeadEvent("waitlist_submit", { ...attribution, ...cityProp });
          document.getElementById("city-form-view")?.setAttribute("hidden", "");
          document.getElementById("city-success")?.removeAttribute("hidden");
        } catch {
          if (errorEl) {
            errorEl.textContent = "Something went wrong. Please try again.";
            errorEl.removeAttribute("hidden");
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
          }
        }
      });
  }
</script>

<style>
  .shows {
    padding: 55px 16px;
    background: var(--charcoal);
    position: relative;
  }
  .shows-header {
    max-width: 1200px;
    margin: 0 auto 40px;
  }
  .shows-header h2 {
    font-family: var(--font-playfair), serif;
    font-size: clamp(32px, 5vw, 60px);
    font-weight: 900;
    color: white;
    line-height: 1;
  }
  .shows-header p {
    font-family: var(--font-cormorant), serif;
    font-style: italic;
    color: rgba(255, 255, 255, 0.7);
    font-size: 18px;
    margin-top: 8px;
  }
  .shows-proof {
    font-family: var(--font-cormorant), serif;
    font-style: italic;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4px;
    letter-spacing: 0.5px;
  }
  .shows-list {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }
  .request-city {
    text-align: center;
    margin-top: 36px;
  }
  .request-city button {
    color: var(--electric-yellow);
    font-weight: bold;
    font-size: 22px;
    background: none;
    border: none;
    min-height: var(--touch-target);
    border-bottom: 1px solid rgba(255, 214, 0, 0.4);
    font-family: var(--font-cormorant), serif;
    font-style: italic;
    transition: border-color 0.2s;
    padding: 0;
    cursor: pointer;
  }
  .request-city button:hover {
    border-color: var(--electric-yellow);
  }

  @media (min-width: 768px) {
    .shows {
      padding: 75px 36px;
    }
    .shows-header {
      margin-bottom: 56px;
    }
  }

  /* ─── Request City Modal ─────────────────────────────────────── */
  .modal-dialog {
    border: none;
    background: transparent;
    padding: 24px;
    max-width: 100%;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .modal-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  .modal-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-inner {
    width: 100%;
    max-width: 400px;
    max-height: 80vh;
    overflow-y: auto;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 20px;
    padding: 24px;
    position: relative;
    animation: modalIn 0.25s ease-out both;
    text-align: center;
  }
  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .modal-dialog.closing .modal-inner {
    animation: dialog-out 0.2s ease-in forwards;
  }
  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 12px;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  .modal-close:hover {
    color: var(--charcoal);
  }
  .modal-close:focus-visible {
    outline: 2px solid var(--brand-red);
    outline-offset: 2px;
    color: var(--charcoal);
  }
  .modal-title {
    font-family: var(--font-playfair), serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--charcoal);
    margin-bottom: 8px;
  }
  .modal-subtitle {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .modal-form input {
    padding: 14px 20px;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 50px;
    font-size: 16px;
    font-family: var(--font-body), sans-serif;
    outline: none;
    transition: border-color 0.2s;
    min-height: var(--touch-target);
  }
  .modal-form input:focus-visible {
    border-color: var(--brand-red);
    outline: 2px solid var(--brand-red);
    outline-offset: -2px;
  }
  .modal-submit {
    background: var(--brand-red);
    color: white;
    border: none;
    padding: 14px;
    border-radius: 50px;
    font-family: var(--font-body), sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.06s;
    min-height: var(--touch-target);
    width: 100%;
  }
  .modal-submit:hover {
    background: var(--brand-red-dark);
  }
  .modal-submit:active {
    transform: scale(0.97);
  }
  .modal-success {
    text-align: center;
    padding: 24px 0;
  }
  .modal-success p {
    font-family: var(--font-cormorant), serif;
    font-size: 18px;
    font-style: italic;
    color: var(--charcoal);
  }
</style>
