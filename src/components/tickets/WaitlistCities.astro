---
import { PAGES } from "@/data/copy";
import type { EventEntry } from "@/data/events";
import HomeShowCards from "@/components/home/HomeShowCards.astro";
import { getWaitlistRanking } from "@/lib/waitlistRanking.server";
import { selectWaitlistCards } from "@/lib/waitlistRanking";
import TicketCard from "./TicketCard.astro";

interface Props {
  upcoming: EventEntry[];
  todayISO: string;
  nowISO: string;
  scheduledCount: number;
  sourcePage?: "tickets" | "home";
}
const {
  upcoming,
  todayISO,
  nowISO,
  scheduledCount,
  sourcePage = "tickets",
} = Astro.props;
let cards: ReturnType<typeof selectWaitlistCards> = [];
try {
  cards = selectWaitlistCards(
    await getWaitlistRanking(),
    upcoming,
    todayISO,
    new Date(nowISO),
  );
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=3600",
  );
} catch (error) {
  console.error(
    "[waitlist-ranking] Unable to load city list",
    error instanceof Error ? error.message : "Unknown error",
  );
  Astro.response.headers.set("Cache-Control", "no-store");
}
---

{sourcePage === "home" ? (
  <HomeShowCards events={cards} />
) : (
  cards.map((event, index) => (
    <TicketCard
      event={event}
      index={index + scheduledCount}
      sourcePage="tickets"
    />
  ))
)}
{cards.length === 0 && <p>{PAGES.tickets.waitlistEmpty}</p>}
