---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PERFORMERS } from "@/data/lineup";
import { buildBreadcrumbJsonLd } from "@/utils/breadcrumbs";

const TITLE = "Meet the Hosts: Surbhi & Wyatt";
const DESC =
  "Meet Surbhi and Wyatt, the stand-up comedians behind Garam Masala Dating. Learn how a show that started at Broadway Comedy Club became NYC's biggest live dating show.";

const { surbhi, wyatt } = PERFORMERS;

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", url: "https://garammasaladating.com/" },
  { name: "Hosts" },
]);

const orgRef = {
  "@type": "Organization",
  "@id": "https://garammasaladating.com/#organization",
  name: "Garam Masala Dating",
};

const personJsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: surbhi.name,
    jobTitle: "Stand-Up Comedian & Co-Creator",
    url: surbhi.instagramUrl,
    sameAs: [surbhi.instagramUrl],
    knowsAbout: [
      "stand-up comedy",
      "South Asian dating",
      "live dating shows",
      "matchmaking",
    ],
    worksFor: orgRef,
    founderOf: orgRef,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: wyatt.name,
    jobTitle: "Stand-Up Comedian & Co-Host",
    url: wyatt.instagramUrl,
    sameAs: [wyatt.instagramUrl],
    knowsAbout: ["stand-up comedy", "live dating shows", "crowd work"],
    worksFor: orgRef,
  },
]);
---

<BaseLayout title={TITLE} description={DESC}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
    <script type="application/ld+json" set:html={personJsonLd} />
  </Fragment>

  <main id="main-content" class="hosts-page">
    <div class="hosts-container">
      <p class="hosts-eyebrow">The Hosts</p>
      <h1>The Comedians Behind the Chaos</h1>
      <p class="hosts-intro">
        Garam Masala Dating didn't come from a pitch deck or a production
        company. It started when two comedians decided that watching real people
        go on blind dates in front of a live audience was funnier than anything
        they could write.
      </p>

      <div class="hosts-action-shot">
        <picture>
          <source srcset="/images/hosts/hosts.avif" type="image/avif" />
          <source srcset="/images/hosts/hosts.webp" type="image/webp" />
          <img
            src="/images/hosts/hosts.webp"
            alt="Surbhi and Wyatt sitting together on stage at Top Secret Comedy Club"
            width="733"
            height="1200"
            loading="lazy"
            style="object-position: center 25%;"
          />
        </picture>
      </div>

      <div class="host-section">
        <img
          src={surbhi.photo}
          alt={surbhi.name}
          class="host-avatar"
          width="96"
          height="96"
          loading="lazy"
        />
        <div class="host-content">
          <h2>
            <a
              href={surbhi.instagramUrl}
              target="_blank"
              rel="noopener noreferrer">{surbhi.name}</a
            >
          </h2>
          <p class="host-role">{surbhi.role}</p>
          {surbhi.bioParagraphs.map((paragraph) => <p set:html={paragraph} />)}
          <div class="host-credits">
            {surbhi.credits.map((credit) => <span>{credit}</span>)}
          </div>
          <p class="host-see-live">
            <a href="/tickets">See {surbhi.name} live →</a>
          </p>
        </div>
      </div>

      <div class="host-section">
        <img
          src={wyatt.photo}
          alt={wyatt.name.split(" ")[0]}
          class="host-avatar"
          width="96"
          height="96"
          loading="lazy"
        />
        <div class="host-content">
          <h2>
            <a
              href={wyatt.instagramUrl}
              target="_blank"
              rel="noopener noreferrer">{wyatt.name}</a
            >
          </h2>
          <p class="host-role">{wyatt.role}</p>
          {wyatt.bioParagraphs.map((paragraph) => <p set:html={paragraph} />)}
          <div class="host-credits">
            {wyatt.credits.map((credit) => <span>{credit}</span>)}
          </div>
          <p class="host-see-live">
            <a href="/tickets">See {wyatt.name.split(" ")[0]} live →</a>
          </p>
        </div>
      </div>

      <div class="hosts-cta">
        <a href="/apply" class="hosts-cta-primary">Apply to Be on the Show</a>
        <a href="/tickets" class="hosts-cta-outline">Get Tickets</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .hosts-page {
    padding: 32px 20px;
  }
  .hosts-container {
    max-width: 720px;
    margin: 0 auto;
  }
  .hosts-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--brand-red);
    margin-bottom: 16px;
  }
  h1 {
    font-family: var(--font-playfair), serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 900;
    color: var(--charcoal);
    line-height: 1.05;
    margin-bottom: 20px;
  }
  .hosts-intro {
    font-family: var(--font-cormorant), serif;
    font-size: 18px;
    font-style: italic;
    color: #666;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hosts-action-shot {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 28px;
    aspect-ratio: 3 / 2;
  }
  .hosts-action-shot picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hosts-action-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .host-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 32px;
  }
  .host-section:last-of-type {
    margin-bottom: 20px;
  }
  .host-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 3px solid var(--brand-red);
    object-fit: cover;
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .host-content h2 {
    margin-bottom: 4px;
  }
  .host-content h2 a {
    font-family: var(--font-cormorant), serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--charcoal);
    text-decoration: none;
    transition: color 0.2s;
  }
  .host-content h2 a:hover {
    color: var(--brand-red);
  }
  .host-role {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--brand-red);
    margin-bottom: 20px;
  }
  .host-content p {
    font-size: 16px;
    color: #444;
    line-height: 1.8;
    margin-bottom: 16px;
  }
  .host-credits {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .host-credits span {
    font-size: 11px;
    font-weight: 600;
    background: rgba(var(--brand-red-rgb), 0.08);
    color: var(--brand-red);
    padding: 4px 12px;
    border-radius: 50px;
    letter-spacing: 0.5px;
  }

  .hosts-cta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }
  .hosts-cta-primary {
    background: var(--brand-red);
    color: white;
    padding: 16px 36px;
    border-radius: 50px;
    font-family: var(--font-body), sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: background 0.2s;
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
  }
  .hosts-cta-primary:hover {
    background: var(--brand-red-dark);
  }
  .hosts-cta-outline {
    color: var(--charcoal);
    padding: 16px 36px;
    border-radius: 50px;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    font-family: var(--font-body), sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: all 0.2s;
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
  }
  .hosts-cta-outline:hover {
    border-color: var(--charcoal);
  }

  @media (min-width: 768px) {
    .hosts-page {
      padding: 48px 48px;
    }
    .hosts-container {
      max-width: 800px;
    }
    .hosts-intro {
      font-size: 20px;
    }
    .host-section {
      flex-direction: row;
      text-align: left;
      gap: 32px;
      align-items: flex-start;
    }
    .host-avatar {
      width: 120px;
      height: 120px;
      font-size: 52px;
      margin-bottom: 0;
    }
    .host-credits {
      justify-content: flex-start;
    }
    .hosts-cta {
      flex-direction: row;
      justify-content: center;
    }
  }

  .host-see-live {
    margin-top: 16px;
  }
  .host-see-live a {
    font-family: var(--font-body), sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--brand-red);
    text-decoration: none;
    transition: color 0.2s;
  }
  .host-see-live a:hover {
    color: var(--brand-red-dark);
  }
</style>
