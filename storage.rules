rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {
    // Same admin gate as firestore.rules. Applicant photos are PII: only a
    // non-anonymous allowlisted account or an admin custom claim reads them
    // (the dashboard resolves stored paths with getBlob).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.email in ['messagesurbhi@gmail.com', 'contact@garammasaladating.com']
            || ('admin' in request.auth.token && request.auth.token.admin == true));
    }

    // WHY there is no client create rule: applicant photos are uploaded with a
    // short-lived signed URL minted by /api/upload-application-photo (or relayed
    // through that endpoint). Signed URLs and the service account bypass these
    // rules, so photos are never rejected by a rule (size, type and anonymous
    // login rules rejected real applicants before). Re-adding a public create
    // rule re-creates that outage class. `{path=**}` matches both the current
    // photos/<draftId>/<n> shape and legacy single-segment photos/<id> objects.
    match /photos/{path=**} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if false;
    }
  }
}
